              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Blocks SQLi payload and returns empty result safely', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array').that.is.empty;",
