            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creates CASH_IN order as FILLED', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
